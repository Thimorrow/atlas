# Neon Postgres (neon.tech -> Project -> Connection Details -> Connection string)
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/atlas?sslmode=require"

# WebUntis (Modul 1, ab M001-S01-T03): Zugang via Untis-Mobile-Secret
WEBUNTIS_SERVER=""
WEBUNTIS_SCHOOL=""
WEBUNTIS_USER=""
WEBUNTIS_SECRET=""

# Microsoft 365 / OneNote (optional).
# Alle drei Werte kommen aus einer App-Registrierung im Azure-Portal, die
# Schritte dazu stehen in der README unter "Microsoft 365 und OneNote".
# Fehlt auch nur einer, bleibt die Anbindung aus und Atlas laeuft unveraendert
# weiter -- die Oberflaeche zeigt dann nur einen Hinweis.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""

# Atlas-Bot (Z.ai, GLM-Modelle, Anthropic-kompatibler Endpoint). Key auf
# https://z.ai erzeugen. Leer lassen -> der Bot schaltet sich stumm ab, der
# Rest der App laeuft unveraendert weiter.
ZAI_API_KEY=""

# Zugangsschutz fuer die oeffentlich erreichbare Bereitstellung (Vercel).
# Leer lassen -> die App ist offen. Das ist der lokale Fall beim Entwickeln.
# Auf Vercel MUSS ATLAS_PASSWORD gesetzt sein, sonst kann jeder mit der URL
# den Stundenplan und die Aufgaben lesen und aendern (die API kennt kein Auth).
ATLAS_PASSWORD=""
# Signiert das Sitzungs-Cookie. Ohne Wert wird ATLAS_PASSWORD genommen; ein
# eigenes Geheimnis ist besser, dann macht ein Passwortwechsel nicht alle
# bestehenden Sitzungen ungueltig. Erzeugen mit: openssl rand -hex 32
# Verschluesselt ausserdem die Microsoft-Tokens in der Datenbank. Ein Wechsel
# macht sie unlesbar, dann meldet man sich einmal neu bei Microsoft an.
ATLAS_SESSION_SECRET=""
