# Neon Postgres (neon.tech -> Project -> Connection Details -> Connection string)
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/atlas?sslmode=require"

# WebUntis (Modul 1, ab M001-S01-T03): Zugang via Untis-Mobile-Secret
WEBUNTIS_SERVER=""
WEBUNTIS_SCHOOL=""
WEBUNTIS_USER=""
WEBUNTIS_SECRET=""

# Zugangsschutz fuer die oeffentlich erreichbare Bereitstellung (Vercel).
# Leer lassen -> die App ist offen. Das ist der lokale Fall beim Entwickeln.
# Auf Vercel MUSS ATLAS_PASSWORD gesetzt sein, sonst kann jeder mit der URL
# den Stundenplan und die Aufgaben lesen und aendern (die API kennt kein Auth).
ATLAS_PASSWORD=""
# Signiert das Sitzungs-Cookie. Ohne Wert wird ATLAS_PASSWORD genommen; ein
# eigenes Geheimnis ist besser, dann macht ein Passwortwechsel nicht alle
# bestehenden Sitzungen ungueltig. Erzeugen mit: openssl rand -hex 32
ATLAS_SESSION_SECRET=""
